{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/denmark-programmes.schema.json",
  "title": "Denmark programme catalogue",
  "type": "object",
  "required": ["meta", "programmes"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["generatedAt", "source", "includedTotal", "counts", "typeCounts", "warning"],
      "properties": {
        "generatedAt": { "type": "string", "format": "date-time" },
        "source": { "type": "string", "format": "uri" },
        "includedTotal": { "type": "integer", "minimum": 0 },
        "counts": {
          "type": "object",
          "required": ["bachelor", "master"],
          "properties": {
            "bachelor": { "type": "integer", "minimum": 0 },
            "master": { "type": "integer", "minimum": 0 }
          }
        },
        "typeCounts": {
          "type": "object",
          "required": ["bachelor", "ap-degree", "top-up-bachelor", "master"],
          "properties": {
            "bachelor": { "type": "integer", "minimum": 0 },
            "ap-degree": { "type": "integer", "minimum": 0 },
            "top-up-bachelor": { "type": "integer", "minimum": 0 },
            "master": { "type": "integer", "minimum": 0 }
          }
        },
        "warning": { "type": "string" }
      }
    },
    "programmes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "level",
          "programmeType",
          "institution",
          "city",
          "topics",
          "description",
          "officialProgrammeUrl",
          "sourceUrl",
          "lastChecked",
          "verificationStatus"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "level": { "enum": ["bachelor", "master"] },
          "programmeType": { "enum": ["bachelor", "ap-degree", "top-up-bachelor", "master"] },
          "institution": { "type": "string", "minLength": 1 },
          "city": { "type": "string", "minLength": 1 },
          "credits": { "type": ["string", "null"] },
          "duration": { "type": ["string", "null"] },
          "topics": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "description": { "type": "string" },
          "intakeDates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": { "type": ["string", "null"], "format": "date" },
                "applicationDeadline": { "type": ["string", "null"], "format": "date" }
              }
            }
          },
          "officialProgrammeUrl": { "type": "string", "format": "uri" },
          "sourceUrl": { "type": "string", "format": "uri" },
          "availabilitySourceUrl": { "type": "string", "format": "uri" },
          "intake2027": {
            "type": "object",
            "required": ["status", "label", "note"],
            "properties": {
              "status": { "enum": ["confirmed-2027", "annual-intake"] },
              "label": { "type": "string", "minLength": 1 },
              "note": { "type": "string", "minLength": 1 }
            }
          },
          "lastChecked": { "type": "string", "format": "date" },
          "verificationStatus": { "enum": ["catalogue-discovery-only", "official-page-checked"] }
        }
      }
    }
  }
}
